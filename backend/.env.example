# Application
APP_NAME=AI Enterprise Automation Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# JWT Authentication
JWT_SECRET_KEY=change-me-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Knowledge document uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25

# Embeddings and vector search
CHROMA_PERSIST_DIR=chroma_data
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY_SCORE=0.5

# Groq LLM (RAG answer generation)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL_NAME=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=512

# Local Whisper speech-to-text (tiny, base, small, medium, large)
WHISPER_MODEL_NAME=base

# Slack (omnichannel bidirectional messaging)
# From Slack App → Basic Information
SLACK_SIGNING_SECRET=your-slack-signing-secret
# From Slack App → Basic Information
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
# From Slack App → OAuth & Permissions → Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Public backend URL used for OAuth redirect and Event Subscriptions
API_PUBLIC_URL=http://localhost:8000

# LinkedIn (omnichannel Company Page comments — Community Management API)
# From LinkedIn Developer Portal → Auth tab
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# Optional: numeric app ID from developer portal URL if different from client ID
# LINKEDIN_DEVELOPER_APPLICATION_ID=
# LinkedIn REST API version header (YYYYMM)
LINKEDIN_API_VERSION=202601
